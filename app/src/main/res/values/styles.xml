<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="BrowserTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorAccent">@color/browser_accent</item>
        <item name="colorControlActivated">@color/browser_accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">@bool/browser_light_bars</item>
        <!-- WebView darkens pages only inside a theme that declares itself dark. -->
        <item name="android:isLightTheme" tools:targetApi="29">@bool/browser_light_bars</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/browser_base</item>
    </style>

    <!-- Applied over BrowserTheme by the appearance settings. -->
    <style name="BrowserTheme.Black" parent="">
        <item name="android:windowBackground">@color/browser_black_base</item>
    </style>
    <style name="BrowserTheme.Dynamic" parent="">
        <item name="colorAccent">@color/browser_dynamic_accent</item>
        <item name="colorControlActivated">@color/browser_dynamic_accent</item>
    </style>

    <style name="BrowserSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/sheet_exit</item>
    </style>
</resources>
